# --- App ---
APP_ENV=development
APP_NAME=latam-valuation-engine
APP_VERSION=0.1.0
LOG_LEVEL=INFO
SECRET_KEY=change-me-in-production-please

# --- API ---
API_V1_PREFIX=/api/v1
CORS_ORIGINS=http://localhost:3000,http://localhost:5173
RATE_LIMIT_PER_MINUTE=60

# --- Database (Supabase / Postgres) ---
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/latam_valuation
SYNC_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/latam_valuation

# --- Redis cache ---
REDIS_URL=redis://localhost:6379/0

# --- Macro data sources (NO secrets, public endpoints) ---
BANREP_API_URL=https://sucre.banrep.gov.co/consultaestadisticas/consultaestadisticas/api
INDEC_API_URL=https://www.indec.gob.ar/
SFC_COL_URL=https://www.superfinanciera.gov.co/

# --- Stripe (leave empty in dev) ---
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_PRO_MONTHLY=
STRIPE_PRICE_ENTERPRISE_MONTHLY=

# --- GitHub Sponsors / Ko-fi (for later) ---
KO_FI_HANDLE=
GITHUB_SPONSORS_USERNAME=AndresGM7

# --- Country defaults ---
DEFAULT_COUNTRY=CO
DEFAULT_INFLATION_OVERRIDE=
DEFAULT_WACC_OVERRIDE=
